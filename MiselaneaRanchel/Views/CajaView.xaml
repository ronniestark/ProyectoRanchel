<UserControl x:Class="MiselaneaRanchel.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Encabezado -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas del Sistema -->
            <RowDefinition Height="*"/>
            <!-- Ingreso Físico y Diferencia -->
            <RowDefinition Height="Auto"/>
            <!-- Botones de Acción -->
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Corte de Caja Diario" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Turno Actual - Administrador" FontSize="16" Foreground="#7F8C8D" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- 2. TARJETAS DEL SISTEMA (LO ESPERADO) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: Fondo Inicial -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="FONDO INICIAL" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="$ 500.00" Foreground="#2C3E50" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: Ventas Efectivo -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="VENTAS EN EFECTIVO" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="$ 3,450.50" Foreground="#2980B9" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: Entradas/Salidas Extras -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SALIDAS EXTRA (PAGOS)" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="- $ 200.00" Foreground="#E74C3C" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 4: Total Esperado -->
            <Border Grid.Column="3" Background="#34495E" CornerRadius="8" Margin="10,0,0,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL ESPERADO EN CAJA" Foreground="#ECF0F1" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="$ 3,750.50" Foreground="#F1C40F" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ARQUEO FÍSICO (LA REALIDAD) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ingreso de Efectivo Real -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Efectivo Real Contado:" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock Text="Ingresa la cantidad exacta de dinero que hay físicamente en la gaveta." TextWrapping="Wrap" Foreground="#7F8C8D" Margin="0,0,0,20"/>

                    <TextBox x:Name="TxtEfectivoReal" FontSize="36" FontWeight="Bold" Foreground="#27AE60" TextAlignment="Center" Height="60" Padding="5" Background="#EAEDED"/>
                </StackPanel>
            </Border>

            <!-- Panel de Diferencia (Faltante / Sobrante) -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,0,0" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Diferencia" FontSize="20" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Center"/>

                    <!-- Este texto cambiará de color por código (Rojo si falta, Verde si sobra) -->
                    <TextBlock x:Name="TxtDiferencia" Text="$ 0.00" FontSize="48" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,15,0,15"/>

                    <TextBlock x:Name="TxtEstadoCaja" Text="CAJA CUADRADA" FontSize="18" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. BOTONES DE ACCIÓN -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Imprimir Reporte" Width="180" Height="45" FontSize="16" FontWeight="Bold" Background="#95A5A6" Foreground="White" BorderBrush="Transparent" Margin="0,0,15,0"/>

            <Button Content="CERRAR TURNO" Width="200" Height="45" FontSize="16" FontWeight="Bold" Background="#E74C3C" Foreground="White" BorderBrush="Transparent"/>
        </StackPanel>
    </Grid>
</UserControl>