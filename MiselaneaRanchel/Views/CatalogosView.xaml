<UserControl x:Class="MiselaneaRanchel.Views.CatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Contenedor de Pestañas -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catálogos del Sistema" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- CONTENEDOR DE PESTAÑAS (TABS) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="Transparent" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="25,12"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                    <Setter Property="Background" Value="#E5E8E8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ============================================== -->
            <!-- PESTAÑA 1: CATEGORÍAS                          -->
            <!-- ============================================== -->
            <TabItem Header="📁 Categorías">
                <Grid Background="White" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Formulario Superior -->
                        <RowDefinition Height="*"/>
                        <!-- Grilla Inferior -->
                    </Grid.RowDefinitions>

                    <!-- Formulario Categorías (Arriba) -->
                    <Border Grid.Row="0" Background="White" Padding="20" CornerRadius="8" Margin="15,15,15,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Datos de la Categoría" FontSize="20" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Input -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Botones -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Nombre de la Categoría:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCatNombre" Height="40" FontSize="16" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnCatLimpiar" Content="Limpiar" Width="100" Height="40" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnCatLimpiar_Click"/>
                                    <Button x:Name="BtnCatEliminar" Content="Dar de Baja" Width="120" Height="40" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnCatEliminar_Click" Visibility="Collapsed"/>
                                    <Button x:Name="BtnCatGuardar" Content="Guardar Categoría" Width="180" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnCatGuardar_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Grilla Categorías (Abajo) -->
                    <Border Grid.Row="1" Margin="15,0,15,15" BorderBrush="#ECF0F1" BorderThickness="1">
                        <DataGrid x:Name="DgCategorias" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgCategorias_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Width="80" Binding="{Binding CategoriaID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre de la Categoría" Width="*" Binding="{Binding Nombre}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- PESTAÑA 2: PROVEEDORES                         -->
            <!-- ============================================== -->
            <TabItem Header="🚚 Proveedores">
                <Grid Background="White" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Formulario Superior -->
                        <RowDefinition Height="*"/>
                        <!-- Grilla Inferior -->
                    </Grid.RowDefinitions>

                    <!-- Formulario Proveedores (Arriba) -->
                    <Border Grid.Row="0" Background="White" Padding="20" CornerRadius="8" Margin="15,15,15,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Datos del Proveedor" FontSize="20" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <!-- Input Nombre -->
                                    <ColumnDefinition Width="1.5*"/>
                                    <!-- Input Telefono -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Botones -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Nombre / Razón Social:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtProvNombre" Height="40" FontSize="16" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="Teléfono de Contacto:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtProvTelefono" Height="40" FontSize="16" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnProvLimpiar" Content="Limpiar" Width="100" Height="40" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnProvLimpiar_Click"/>
                                    <Button x:Name="BtnProvEliminar" Content="Dar de Baja" Width="120" Height="40" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnProvEliminar_Click" Visibility="Collapsed"/>
                                    <Button x:Name="BtnProvGuardar" Content="Guardar Proveedor" Width="180" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnProvGuardar_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Grilla Proveedores (Abajo) -->
                    <Border Grid.Row="1" Margin="15,0,15,15" BorderBrush="#ECF0F1" BorderThickness="1">
                        <DataGrid x:Name="DgProveedores" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgProveedores_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Width="80" Binding="{Binding ProveedorID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre del Proveedor" Width="*" Binding="{Binding Nombre}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Teléfono" Width="200" Binding="{Binding Telefono}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- PESTAÑA 3: UNIDADES DE MEDIDA                  -->
            <!-- ============================================== -->
            <TabItem Header="⚖️ Unidades de Medida">
                <Grid Background="White" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Formulario Superior -->
                        <RowDefinition Height="*"/>
                        <!-- Grilla Inferior -->
                    </Grid.RowDefinitions>

                    <!-- Formulario Unidades (Arriba) -->
                    <Border Grid.Row="0" Background="White" Padding="20" CornerRadius="8" Margin="15,15,15,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Gestionar Unidades" FontSize="20" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <!-- Input Nombre -->
                                    <ColumnDefinition Width="1*"/>
                                    <!-- Input Abreviatura -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Botones -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Nombre (Ej. Kilogramo):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtUniNombre" Height="40" FontSize="16" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="Abreviatura (Ej. Kg):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtUniAbreviatura" Height="40" FontSize="16" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnUniLimpiar" Content="Limpiar" Width="100" Height="40" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnUniLimpiar_Click"/>
                                    <Button x:Name="BtnUniEliminar" Content="Dar de Baja" Width="120" Height="40" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnUniEliminar_Click" Visibility="Collapsed"/>
                                    <Button x:Name="BtnUniGuardar" Content="Guardar Unidad" Width="180" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnUniGuardar_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Grilla Unidades (Abajo) -->
                    <Border Grid.Row="1" Margin="15,0,15,15" BorderBrush="#ECF0F1" BorderThickness="1">
                        <DataGrid x:Name="DgUnidades" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgUnidades_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Width="80" Binding="{Binding UnidadMedidaID}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nombre de la Unidad" Width="*" Binding="{Binding Nombre}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Abreviatura" Width="150" Binding="{Binding Abreviatura}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>