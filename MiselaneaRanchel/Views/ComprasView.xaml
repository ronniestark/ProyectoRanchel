<UserControl x:Class="MiselaneaRanchel.Views.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Contenedor de Pestañas -->
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Grid.Row="0" Text="Módulo de Compras e Ingresos" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- CONTENEDOR DE PESTAÑAS (ESTILO WEB) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <!-- Estilo Web Moderno para los Tabs -->
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,10" Margin="0,0,15,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2980B9"/>
                                        <Setter Property="Foreground" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#34495E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </TabControl.Resources>

            <!-- ============================================== -->
            <!-- PESTAÑA 1: NUEVA COMPRA                        -->
            <!-- ============================================== -->
            <TabItem Header="➕ Registrar Nueva Compra">
                <Border Background="Transparent" Margin="0,15,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. DATOS DEL PROVEEDOR Y FACTURA -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Proveedor:" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                        <ComboBox x:Name="CmbProveedor" Height="38" FontSize="15" IsEditable="True" Text="Seleccionar..." VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="5,0"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="N° Factura / Remisión:" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                        <TextBox x:Name="TxtFactura" Height="38" FontSize="15" Padding="10,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fecha de Ingreso:" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                        <DatePicker x:Name="DpFecha" Height="38" FontSize="15" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. INGRESO RÁPIDO DE PRODUCTO -->
                        <Border Grid.Row="1" Background="#34495E" CornerRadius="8" Padding="20" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#2C3E50" BlurRadius="8" ShadowDepth="2" Opacity="0.4"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="🔍 Buscar Producto (Código o Nombre):" FontWeight="Bold" Foreground="#ECF0F1" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#7F8C8D" BorderThickness="1" CornerRadius="5" Background="White">
                                        <ComboBox x:Name="CmbBuscarProducto" Height="40" FontSize="16" IsEditable="True" 
                                                  IsTextSearchEnabled="False" StaysOpenOnEdit="True" VerticalContentAlignment="Center" Padding="5,0"
                                                  TextBoxBase.TextChanged="CmbBuscarProducto_TextChanged"
                                                  SelectionChanged="CmbBuscarProducto_SelectionChanged"
                                                  KeyDown="CmbBuscarProducto_KeyDown" Background="Transparent" BorderThickness="0"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                                    <TextBlock Text="Costo Unit. ($):" FontWeight="Bold" Foreground="#ECF0F1" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#7F8C8D" BorderThickness="1" CornerRadius="5" Background="White">
                                        <TextBox x:Name="TxtCosto" Height="40" FontSize="16" Padding="10,0" VerticalContentAlignment="Center" TextAlignment="Right" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#D35400"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,15,0">
                                    <TextBlock Text="Cantidad a Sumar:" FontWeight="Bold" Foreground="#ECF0F1" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#7F8C8D" BorderThickness="1" CornerRadius="5" Background="White">
                                        <TextBox x:Name="TxtCantidad" Height="40" FontSize="16" Padding="10,0" VerticalContentAlignment="Center" TextAlignment="Center" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#2980B9" KeyDown="TxtCantidad_KeyDown"/>
                                    </Border>
                                </StackPanel>

                                <Button x:Name="BtnAgregar" Grid.Column="3" Height="40" Padding="20,0" VerticalAlignment="Bottom" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnAgregarProducto_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="➕" Margin="0,0,5,0"/>
                                        <TextBlock Text="Agregar (Enter)"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. LISTA DE COMPRAS (CARRITO) -->
                        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>

                            <DataGrid x:Name="DgListaCompras" Background="Transparent" BorderThickness="0" 
                                      AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" 
                                      HeadersVisibility="Column" SelectionMode="Single"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8F9F9"/>
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="10,12"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                        <Setter Property="BorderBrush" Value="#E5E8E8"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Foreground" Value="#34495E"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F4F6F7"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EAF2F8"/>
                                                <Setter Property="Foreground" Value="#2980B9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CÓDIGO" Width="130" Binding="{Binding Codigo}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO" Width="*" Binding="{Binding Descripcion}" IsReadOnly="True"/>

                                    <DataGridTextColumn Header="CANTIDAD" Width="100" Binding="{Binding Cantidad}" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#2980B9"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="COSTO UNIT. ($)" Width="140" Binding="{Binding CostoUnitario, StringFormat=C2}" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="SUBTOTAL ($)" Width="150" Binding="{Binding SubTotal, StringFormat=C2}" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Foreground" Value="#D35400"/>
                                                <Setter Property="FontWeight" Value="ExtraBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 4. TOTALES Y ACCIÓN FINAL -->
                        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnLimpiarNueva" Grid.Column="0" Height="45" Padding="20,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnLimpiarNueva_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🧹" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Limpiar / Nueva Compra" FontSize="14"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL FACTURA:" FontSize="18" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtTotalFactura" Text="$ 0.00" FontSize="36" FontWeight="ExtraBold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,25,0"/>

                                    <Button x:Name="BtnProcesar" Height="55" Padding="25,0" Background="#2980B9" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Click="BtnProcesarCompra_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📦" Margin="0,0,10,0" FontSize="20"/>
                                            <TextBlock Text="PROCESAR INGRESO" FontSize="18" FontWeight="ExtraBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================================== -->
            <!-- PESTAÑA 2: HISTORIAL DE COMPRAS                -->
            <!-- ============================================== -->
            <TabItem Header="📋 Historial de Compras">
                <Border Background="White" Margin="0,15,0,0" Padding="20" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Todas las compras registradas en la base de datos:" FontSize="18" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                           
                            <Button Grid.Column="1" Height="38" Padding="15,0" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnActualizarHistorial_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" Margin="0,0,5,0"/>
                                    <TextBlock Text="Actualizar Tabla"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- TABLA HISTORIAL -->
                        <DataGrid x:Name="DgHistorialCompras" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" 
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1"
                                  MouseDoubleClick="DgHistorialCompras_MouseDoubleClick">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E5E8E8"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#34495E"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F6F7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2F8"/>
                                            <Setter Property="Foreground" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID COMPRA" Width="100" Binding="{Binding CompraID}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="PROVEEDOR" Width="*" Binding="{Binding Proveedor.Nombre}" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="N° FACTURA" Width="150" Binding="{Binding NumeroFactura}"/>

                                <DataGridTextColumn Header="FECHA INGRESO" Width="160" Binding="{Binding FechaCompra, StringFormat=dd/MM/yyyy HH:mm}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="ESTADO" Width="120" Binding="{Binding Estado}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="TOTAL PAGADO" Width="160" Binding="{Binding TotalCompra, StringFormat=C2}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#D35400"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>