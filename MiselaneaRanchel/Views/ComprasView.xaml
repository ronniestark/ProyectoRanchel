<UserControl x:Class="MiselaneaRanchel.Views.ComprasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Contenedor de Pestañas -->
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Grid.Row="0" Text="Módulo de Compras" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- CONTENEDOR DE PESTAÑAS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="Transparent" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="25,12"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                    <Setter Property="Background" Value="#E5E8E8"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,0,5,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ============================================== -->
            <!-- PESTAÑA 1: NUEVA COMPRA                        -->
            <!-- ============================================== -->
            <TabItem Header="➕ Registrar Nueva Compra">
                <!-- Solución: El Padding no va en el Grid, he envuelto el contenido en un Border -->
                <Border Background="White" Margin="0,10,0,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DATOS DEL PROVEEDOR -->
                        <Border Grid.Row="0" Background="#F8F9F9" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Proveedor:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbProveedor" Height="35" FontSize="14" IsEditable="True" Text="Seleccionar..."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="15,0,15,0">
                                    <TextBlock Text="N° Factura / Remisión:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtFactura" Height="35" FontSize="14" Padding="5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="15,0,0,0">
                                    <TextBlock Text="Fecha de Ingreso:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="DpFecha" Height="35" FontSize="14"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- INGRESO RÁPIDO DE PRODUCTO -->
                        <Border Grid.Row="1" Background="#34495E" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Buscar Producto (Escribe nombre o código):" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CmbBuscarProducto" Height="35" FontSize="16" IsEditable="True" 
                                              IsTextSearchEnabled="False" StaysOpenOnEdit="True" 
                                              TextBoxBase.TextChanged="CmbBuscarProducto_TextChanged"
                                              SelectionChanged="CmbBuscarProducto_SelectionChanged"
                                              KeyDown="CmbBuscarProducto_KeyDown"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                    <TextBlock Text="Costo Unitario:" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCosto" Height="35" FontSize="16" Padding="5" TextAlignment="Right"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,15,0">
                                    <TextBlock Text="Cantidad a Sumar:" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCantidad" Height="35" FontSize="16" Padding="5" TextAlignment="Center" KeyDown="TxtCantidad_KeyDown"/>
                                </StackPanel>

                                <Button x:Name="BtnAgregar" Grid.Column="3" Content="Agregar (Enter)" Width="120" Height="35" VerticalAlignment="Bottom" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnAgregarProducto_Click"/>
                            </Grid>
                        </Border>

                        <!-- LISTA DE COMPRAS (CARRITO) -->
                        <DataGrid x:Name="DgListaCompras" Grid.Row="2" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="35" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Width="100" Binding="{Binding Codigo}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Descripción del Producto" Width="*" Binding="{Binding Descripcion}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Cantidad" Width="100" Binding="{Binding Cantidad}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Costo Unit. ($)" Width="120" Binding="{Binding CostoUnitario, StringFormat=N2}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Subtotal ($)" Width="120" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- TOTALES Y ACCIÓN FINAL -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnLimpiarNueva" Grid.Column="0" HorizontalAlignment="Left" Content="Limpiar / Nueva Compra" Width="200" Height="45" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnLimpiarNueva_Click"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL FACTURA:" FontSize="20" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock x:Name="TxtTotalFactura" Text="$ 0.00" FontSize="36" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,25,0"/>
                                <Button x:Name="BtnProcesar" Content="PROCESAR INGRESO AL INVENTARIO" Height="50" Padding="20,0" Background="#2980B9" Foreground="White" FontSize="16" FontWeight="Bold" BorderBrush="Transparent" Click="BtnProcesarCompra_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ============================================== -->
            <!-- PESTAÑA 2: HISTORIAL DE COMPRAS                -->
            <!-- ============================================== -->
            <TabItem Header="📋 Historial de Compras (Tabla)">
                <!-- Solución: El Padding no va en el Grid, he envuelto el contenido en un Border -->
                <Border Background="White" Margin="0,10,0,0" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Todas las compras registradas en la base de datos:" FontSize="16" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <Button Content="Actualizar Tabla" Width="120" Height="30" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnActualizarHistorial_Click"/>
                        </StackPanel>

                        <!-- TABLA QUE MUESTRA TODO EL SELECT DE COMPRAS -->
                        <DataGrid x:Name="DgHistorialCompras" Grid.Row="1" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="35" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Compra" Width="80" Binding="{Binding CompraID}"/>
                                <DataGridTextColumn Header="Proveedor" Width="*" Binding="{Binding Proveedor.Nombre}"/>
                                <DataGridTextColumn Header="N° Factura" Width="150" Binding="{Binding NumeroFactura}"/>
                                <DataGridTextColumn Header="Fecha de Compra" Width="150" Binding="{Binding FechaCompra, StringFormat=dd/MM/yyyy HH:mm}"/>
                                <DataGridTextColumn Header="Estado" Width="120" Binding="{Binding Estado}"/>
                                <DataGridTextColumn Header="Total Pagado ($)" Width="150" Binding="{Binding TotalCompra, StringFormat=N2}" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>