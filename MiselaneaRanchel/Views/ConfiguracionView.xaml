<UserControl x:Class="MiselaneaRanchel.Views.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Grid.Row="0" Text="Administración de Productos" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- 1. FORMULARIO EN LA PARTE SUPERIOR -->
        <Border Grid.Row="1" Background="White" Padding="20" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Código, Nombre, Categoría y Unidad -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Código -->
                        <ColumnDefinition Width="2*"/>
                        <!-- Nombre -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Categoría (NUEVO) -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Unidad -->
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Código de Barras:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCodigo" Height="35" FontSize="14" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Nombre del Producto:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNombre" Height="35" FontSize="14" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Categoría:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbCategoria" Height="35" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Unidad de Medida:" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbUnidad" Height="35" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Fila 2: Costo, Ganancia, Precio Final y Botones -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Costo Unitario ($):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCosto" Height="35" FontSize="14" Padding="5" TextChanged="CalcularPrecioFinal_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Ganancia (%):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtGanancia" Height="35" FontSize="14" Padding="5" TextChanged="CalcularPrecioFinal_TextChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="Precio Final Venta ($):" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPrecioVenta" Height="35" FontSize="14" Background="#EAEDED" IsReadOnly="True" Padding="5" Foreground="#2C3E50" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Botones de Acción -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="BtnLimpiar" Content="Limpiar" Width="100" Height="35" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnLimpiar_Click"/>
                        <Button x:Name="BtnEliminar" Content="Dar de Baja" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Click="BtnEliminar_Click" Visibility="Collapsed"/>
                        <Button x:Name="BtnGuardar" Content="Guardar Producto" Width="160" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Click="BtnGuardar_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. GRILLA DE PRODUCTOS EN LA PARTE INFERIOR -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Lista de Productos" FontSize="18" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <TextBox x:Name="TxtBuscarGrilla" Width="300" Height="30" Padding="5,0,0,0" VerticalContentAlignment="Center" TextChanged="TxtBuscarGrilla_TextChanged"/>
                    <TextBlock Text="🔍 Buscar..." Foreground="#BDC3C7" IsHitTestVisible="False" VerticalAlignment="Center" Margin="-290,0,0,0"/>
                </StackPanel>

                <DataGrid x:Name="DgProductos" Grid.Row="1" Background="White" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="35" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="DgProductos_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Width="120" Binding="{Binding CodigoBarras}"/>
                        <DataGridTextColumn Header="Nombre del Producto" Width="*" Binding="{Binding Descripcion}"/>
                        <DataGridTextColumn Header="Categoría" Width="120" Binding="{Binding Categoria.Nombre}"/>
                        <DataGridTextColumn Header="Unidad" Width="80" Binding="{Binding UnidadMedida.Abreviatura}"/>
                        <DataGridTextColumn Header="Costo" Width="100" Binding="{Binding PrecioCosto, StringFormat=C2}"/>
                        <DataGridTextColumn Header="Margen (%)" Width="100" Binding="{Binding MargenGanancia, StringFormat=N2}"/>
                        <DataGridTextColumn Header="Precio Venta" Width="120" FontWeight="Bold" Binding="{Binding PrecioVenta, StringFormat=C2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>