<UserControl x:Class="MiselaneaRanchel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabecera -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas Principales -->
            <RowDefinition Height="*"/>
            <!-- Tablas de Detalles -->
        </Grid.RowDefinitions>

        <!-- 1. CABECERA -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Panel de Control (Dashboard)" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Resumen de Hoy" FontSize="20" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Bottom" Margin="15,0,0,4"/>
            </StackPanel>

            <Button x:Name="BtnActualizar" Content="Actualizar Datos" Width="150" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" BorderBrush="Transparent" Click="BtnActualizar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- 2. TARJETAS DE ESTADÍSTICAS (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: INGRESOS POR VENTAS -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="INGRESOS POR VENTAS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtVentasHoy" Text="C$ 0.00" Foreground="#27AE60" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: GANANCIA NETA -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="GANANCIA ESTIMADA" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtGananciaHoy" Text="C$ 0.00" Foreground="#2980B9" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: PRODUCTOS VENDIDOS -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ARTÍCULOS VENDIDOS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtArticulosVendidos" Text="0" Foreground="#8E44AD" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 4: TICKETS / CLIENTES -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Margin="10,0,0,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TICKETS GENERADOS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTicketsHoy" Text="0" Foreground="#E67E22" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. SECCIÓN INFERIOR: TOP PRODUCTOS Y ALERTAS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Productos Vendidos -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🔥 Top 5 Productos Más Vendidos" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>

                    <!-- TABLA MEJORADA Y ELEGANTE -->
                    <DataGrid x:Name="DgTopProductos" Grid.Row="1" 
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                              RowHeight="45" Background="Transparent" BorderThickness="0"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">

                        <DataGrid.Resources>
                            <!-- Estilo de las Cabeceras -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8F9F9"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="#E5E8E8"/>
                            </Style>

                            <!-- Estilo de las Filas (Hover y Selección) -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#34495E"/>
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F4F6F7"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF2F8"/>
                                        <Setter Property="Foreground" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Estilo de las Celdas -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Columna Producto (Izquierda) -->
                            <DataGridTextColumn Header="PRODUCTO" Width="*" Binding="{Binding Descripcion}"/>

                            <!-- Columna Cantidad (Centrada) -->
                            <DataGridTextColumn Header="CANTIDAD" Width="120" Binding="{Binding TotalVendido}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#8E44AD"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Columna Total Dinero (Derecha y color verde) -->
                            <DataGridTextColumn Header="TOTAL INGRESO" Width="150" Binding="{Binding TotalDinero, StringFormat=C$ \{0:N2\}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Alertas de Inventario -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Alertas de Sistema" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                    <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="⚠️ BAJO STOCK" Foreground="#E74C3C" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtBajoStock" Text="0 productos" Foreground="#C0392B" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF9E7" BorderBrush="#F1C40F" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="💸 GASTOS/COMPRAS DE HOY" Foreground="#D4AC0D" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtGastosHoy" Text="C$ 0.00" Foreground="#B7950B" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>