<UserControl x:Class="MiselaneaRanchel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Cabecera -->
            <RowDefinition Height="Auto"/>
            <!-- Tarjetas Principales -->
            <RowDefinition Height="*"/>
            <!-- Tablas de Detalles -->
        </Grid.RowDefinitions>

        <!-- 1. CABECERA -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Panel de Control (Dashboard)" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Resumen de Hoy" FontSize="20" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Bottom" Margin="15,0,0,4"/>
            </StackPanel>

            <Button x:Name="BtnActualizar" Content="Actualizar Datos" Width="150" Height="40" Background="#3498DB" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" BorderBrush="Transparent" Click="BtnActualizar_Click"/>
        </Grid>

        <!-- 2. TARJETAS DE ESTADÍSTICAS (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjeta 1: INGRESOS POR VENTAS -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="INGRESOS POR VENTAS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtVentasHoy" Text="$ 0.00" Foreground="#27AE60" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 2: GANANCIA NETA -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="GANANCIA ESTIMADA" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtGananciaHoy" Text="$ 0.00" Foreground="#2980B9" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 3: PRODUCTOS VENDIDOS -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" Margin="10,0,10,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ARTÍCULOS VENDIDOS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtArticulosVendidos" Text="0" Foreground="#8E44AD" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta 4: TICKETS / CLIENTES -->
            <Border Grid.Column="3" Background="White" CornerRadius="8" Margin="10,0,0,0" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TICKETS GENERADOS" Foreground="#7F8C8D" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTicketsHoy" Text="0" Foreground="#E67E22" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. SECCIÓN INFERIOR: TOP PRODUCTOS Y ALERTAS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Top Productos Vendidos -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Top 5 Productos Más Vendidos Hoy" FontSize="18" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

                    <DataGrid x:Name="DgTopProductos" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="35" Background="White" HeadersVisibility="Column" SelectionMode="Single" AlternatingRowBackground="#F9F9F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Width="*" Binding="{Binding Descripcion}"/>
                            <DataGridTextColumn Header="Cantidad" Width="100" Binding="{Binding TotalVendido}"/>
                            <DataGridTextColumn Header="Total Ingreso" Width="120" Binding="{Binding TotalDinero, StringFormat=C2}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Alertas de Inventario -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Alertas de Sistema" FontSize="18" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,15"/>

                    <Border Background="#FDEDEC" BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="PRODUCTOS CON BAJO STOCK" Foreground="#E74C3C" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtBajoStock" Text="0 productos" Foreground="#C0392B" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FEF9E7" BorderBrush="#F1C40F" BorderThickness="1" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="GASTOS/COMPRAS DE HOY" Foreground="#D4AC0D" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="TxtGastosHoy" Text="$ 0.00" Foreground="#B7950B" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>