<Window x:Class="MiselaneaRanchel.Views.DetalleVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del Ticket de Venta" Height="550" Width="700" 
        WindowStartupLocation="CenterScreen" Background="#ECF0F1" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Encabezado de la Ventana -->
        <TextBlock Text="Detalle del Ticket de Venta" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- 2. Tarjeta con los datos de la venta -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="N° Ticket:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtTicket" Text="TCK-0000" FontSize="18" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Fecha y Hora:" FontWeight="Bold" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtFecha" Text="dd/mm/yyyy HH:mm" FontSize="16" FontWeight="SemiBold" Foreground="#34495E"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Grilla con los Productos -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <DataGrid x:Name="DgDetalles" Background="Transparent" BorderThickness="0" 
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      RowHeight="35" HeadersVisibility="Column" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8F9F9"/>
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="#E5E8E8"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="CÓDIGO" Width="120" Binding="{Binding Producto.CodigoBarras}"/>
                    <DataGridTextColumn Header="PRODUCTO" Width="*" Binding="{Binding Producto.Descripcion}"/>
                    <DataGridTextColumn Header="CANT." Width="80" Binding="{Binding Cantidad}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#2980B9"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PRECIO UNIT." Width="120" Binding="{Binding PrecioVentaHistorico, StringFormat=C$ \{0:N2\}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SUBTOTAL" Width="130" Binding="{Binding SubTotal, StringFormat=C$ \{0:N2\}}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. Total y Botón de Cerrar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnCerrar" Grid.Column="0" Content="Cerrar Ventana" Width="150" Height="40" HorizontalAlignment="Left" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnCerrar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="TOTAL COBRADO:" FontSize="16" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTotalFactura" Text="$ 0.00" FontSize="30" FontWeight="ExtraBold" Foreground="#27AE60" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>