<UserControl x:Class="MiselaneaRanchel.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#ECF0F1" Loaded="UserControl_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TÍTULO -->
        <TextBlock Grid.Row="0" Text="Reportes y Estadísticas" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- 2. FILTROS DE FECHA Y ACCIONES -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="Desde:" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="DpDesde" Height="35" Width="130" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hasta (o Día Exacto):" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="DpHasta" Height="35" Width="130" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnExportarPDF" Click="BtnExportarPDF_Click" Content="Guardar como PDF" Height="38" Padding="15,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnExportarExcel" Click="BtnExportarExcel_Click" Content="Exportar a Excel" Height="38" Padding="15,0" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MENÚ LATERAL DE REPORTES CATEGORIZADO -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,15,0">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- CATEGORÍA: VENTAS Y CAJA -->
                        <TextBlock Text="Ventas y Caja" FontSize="16" FontWeight="Bold" Foreground="#2980B9" Margin="0,0,0,10"/>
                        <Button x:Name="BtnCierreCaja" Click="BtnCierreCaja_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="💰 Cierre de Caja (Día exacto)" FontWeight="SemiBold" FontSize="14"/>
                        </Button>

                        <!-- CATEGORÍA: INVENTARIO -->
                        <TextBlock Text="Control de Inventario" FontSize="16" FontWeight="Bold" Foreground="#2980B9" Margin="0,15,0,10"/>
                        <Button x:Name="BtnStock" Click="BtnStock_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="📦 Stock Actual en Bodega" FontWeight="SemiBold" FontSize="14"/>
                        </Button>
                        <Button x:Name="BtnKardex" Click="BtnKardex_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="🔄 Kardex (Movimientos)" FontWeight="SemiBold" FontSize="14"/>
                        </Button>

                        <!-- CATEGORÍA: CONTABILIDAD -->
                        <TextBlock Text="Contabilidad y Finanzas" FontSize="16" FontWeight="Bold" Foreground="#2980B9" Margin="0,15,0,10"/>
                        <Button x:Name="BtnAsientoContable" Click="BtnAsientoContable_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="📒 Asiento Contable (Diario)" FontWeight="SemiBold" FontSize="14"/>
                        </Button>
                        <Button x:Name="BtnEstadoResultados" Click="BtnEstadoResultados_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="📄 Estado de Resultados" FontWeight="SemiBold" FontSize="14"/>
                        </Button>
                        <Button x:Name="BtnBalanceGeneral" Click="BtnBalanceGeneral_Click" Height="40" Background="#F8F9F9" Foreground="#34495E" BorderBrush="#ECF0F1" BorderThickness="1" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0,0,0" Cursor="Hand">
                            <TextBlock Text="⚖️ Balance General" FontWeight="SemiBold" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- VISOR DE PDF -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtTituloReporte" Grid.Row="0" Text="Seleccione fechas y presione un reporte para generar la vista previa..." FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <wv2:WebView2 x:Name="PdfViewer" Grid.Row="1"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>