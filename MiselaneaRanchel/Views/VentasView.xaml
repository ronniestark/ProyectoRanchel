<UserControl x:Class="MiselaneaRanchel.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#ECF0F1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="*"/>
            <!-- Contenedor de Pestañas -->
        </Grid.RowDefinitions>

        <!-- 1. TÍTULO -->
        <TextBlock Grid.Row="0" Text="Módulo de Ventas" FontSize="32" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- 2. CONTENEDOR DE PESTAÑAS (ESTILO WEB) -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <!-- Estilo Web Moderno para los Tabs -->
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,10" Margin="0,0,15,0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Cursor="Hand">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2980B9"/>
                                        <Setter Property="Foreground" Value="#2980B9"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#34495E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </TabControl.Resources>

            <!-- ============================================== -->
            <!-- PESTAÑA 1: PUNTO DE VENTA (CARRITO)            -->
            <!-- ============================================== -->
            <TabItem Header="🛒 Punto de Venta">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BUSCADOR Y CANTIDAD -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Campo de Cantidad -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="Cant:" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                        <TextBox x:Name="TxtCantidad" Text="1" Width="70" Height="43" FontSize="20" Padding="0,5" TextAlignment="Center" Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="#2980B9" KeyDown="TxtCantidad_KeyDown"/>
                                    </Border>
                                </StackPanel>

                                <!-- Buscador Original -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Código de Barras o Producto (F3):" FontWeight="Bold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                        <TextBox x:Name="TxtBuscador" Height="43" FontSize="20" Padding="10,5" Background="Transparent" BorderThickness="0" FontWeight="SemiBold" Foreground="#2C3E50"
                                                 KeyDown="TxtBuscador_KeyDown" TextChanged="TxtBuscador_TextChanged"/>
                                    </Border>

                                    <!-- MENÚ EMERGENTE PARA SUGERENCIAS -->
                                    <Popup x:Name="PopupSugerencias" PlacementTarget="{Binding ElementName=TxtBuscador}" Placement="Bottom" StaysOpen="False" Width="{Binding ElementName=TxtBuscador, Path=ActualWidth}">
                                        <Border BorderBrush="#BDC3C7" BorderThickness="1" Background="White" MaxHeight="200" CornerRadius="0,0,5,5">
                                            <ListBox x:Name="LstSugerencias" Background="White" BorderThickness="0" 
                                                     SelectionChanged="LstSugerencias_SelectionChanged" KeyDown="LstSugerencias_KeyDown">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="5,8">
                                                            <TextBlock Text="{Binding CodigoBarras}" FontWeight="Bold" Foreground="#2980B9" Width="130"/>
                                                            <TextBlock Text="{Binding Descripcion}" Foreground="#34495E" FontSize="16" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="BtnBuscar" Grid.Column="1" Height="45" Margin="15,20,0,0" Padding="20,0" Background="#34495E" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" VerticalAlignment="Bottom" Cursor="Hand" Click="BtnBuscar_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Buscar / Agregar" FontSize="15"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- DATA GRID / CARRITO (CENTRO) -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <DataGrid x:Name="DgCarrito" Background="Transparent" BorderThickness="0" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                  RowHeight="45" HeadersVisibility="Column" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Padding" Value="10,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E5E8E8"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#34495E"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F6F7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2F8"/>
                                            <Setter Property="Foreground" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CÓDIGO" Width="150" Binding="{Binding Codigo}"/>
                                <DataGridTextColumn Header="DESCRIPCIÓN DEL PRODUCTO" Width="*" Binding="{Binding Descripcion}"/>
                                <DataGridTextColumn Header="CANTIDAD" Width="120" Binding="{Binding Cantidad}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#2980B9"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="PRECIO UNIT." Width="150" Binding="{Binding PrecioVenta, StringFormat=C$ \{0:N2\}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="SUBTOTAL" Width="160" Binding="{Binding SubTotal, StringFormat=C$ \{0:N2\}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- PANEL DE COBRO Y TOTALES (INFERIOR) -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lado Izquierdo -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="🛒 Artículos en carrito:" FontSize="16" Foreground="#7F8C8D" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtTotalArticulos" Text="0" FontSize="16" FontWeight="Bold" Foreground="#2980B9"/>
                                </StackPanel>
                                <Button x:Name="BtnCancelarVenta" Height="40" Width="160" Background="#E74C3C" Foreground="White" BorderBrush="Transparent" HorizontalAlignment="Left" Cursor="Hand" Click="BtnCancelarVenta_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✖" Margin="0,0,8,0" FontSize="14"/>
                                        <TextBlock Text="Cancelar Venta" FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Lado Derecho (Cobro) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid Margin="0,0,30,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Efectivo Recibido:" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center" Margin="0,0,15,15"/>
                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9" Margin="0,0,0,15">
                                        <TextBox x:Name="TxtEfectivo" Width="130" Height="40" FontSize="22" FontWeight="Bold" TextAlignment="Right" Foreground="#2980B9" Background="Transparent" BorderThickness="0" Padding="5,0,10,0" VerticalContentAlignment="Center" TextChanged="TxtEfectivo_TextChanged"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cambio a Entregar:" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TxtCambio" Grid.Row="1" Grid.Column="1" Text="C$ 0.00" FontSize="26" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                </Grid>

                                <Border Width="2" Background="#ECF0F1" Margin="0,0,30,0" CornerRadius="1"/>

                                <StackPanel Margin="0,0,30,0" VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL A PAGAR" FontSize="14" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtTotalPagar" Text="C$ 0.00" FontSize="56" FontWeight="ExtraBold" Foreground="#27AE60" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <Button x:Name="BtnCobrar" Height="85" Width="220" Background="#27AE60" Foreground="White" BorderBrush="Transparent" Cursor="Hand" Click="BtnCobrar_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="C💲" Margin="0,0,10,0" FontSize="28"/>
                                        <TextBlock Text="COBRAR" FontSize="26" FontWeight="ExtraBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================== -->
            <!-- PESTAÑA 2: HISTORIAL DE VENTAS                 -->
            <!-- ============================================== -->
            <TabItem Header="📋 Historial de Ventas">
                <Border Background="White" Margin="0,15,0,0" Padding="20" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect Color="#BDC3C7" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filtros Superiores -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Desde:" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                    <DatePicker x:Name="DpDesdeVentas" Height="35" Width="130" FontSize="14" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="Hasta:" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                    <DatePicker x:Name="DpHastaVentas" Height="35" Width="130" FontSize="14" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <!-- Buscador por Ticket -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Buscar N° Ticket:" FontWeight="Bold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Background="#F8F9F9">
                                    <TextBox x:Name="TxtFiltroTicket" Height="35" Width="180" FontSize="14" Padding="8,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="3" Height="38" Padding="15,0" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent" Cursor="Hand" Click="BtnFiltrarHistorial_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔍" Margin="0,0,5,0"/>
                                    <TextBlock Text="Filtrar Ventas"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- TABLA HISTORIAL -->
                        <DataGrid x:Name="DgHistorialVentas" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="40" 
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECF0F1"
                                  MouseDoubleClick="DgHistorialVentas_MouseDoubleClick">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8F9F9"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    <Setter Property="BorderBrush" Value="#E5E8E8"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#34495E"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F4F6F7"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EAF2F8"/>
                                            <Setter Property="Foreground" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N° TICKET" Width="200" Binding="{Binding NumeroTicket}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#2980B9"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="FECHA DE VENTA" Width="*" Binding="{Binding FechaVenta, StringFormat=dd/MM/yyyy HH:mm}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="EFECTIVO" Width="140" Binding="{Binding EfectivoRecibido, StringFormat=C$ \{0:N2\}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#7F8C8D"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="CAMBIO" Width="140" Binding="{Binding CambioEntregado, StringFormat=C$ \{0:N2\}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#E74C3C"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="TOTAL COBRADO" Width="180" Binding="{Binding TotalVenta, StringFormat=C$ \{0:N2\}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#27AE60"/>
                                            <Setter Property="FontWeight" Value="ExtraBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>